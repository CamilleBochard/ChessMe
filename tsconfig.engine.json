{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "noEmit": true
  },
  "include": ["src/engine/**/*.ts", "src/evaluation/**/*.ts", "src/game/**/*.ts", "src/board/**/*.ts"],
  // Tests run under Node and may read files, which the code they test must not.
  "exclude": ["src/**/*.test.ts"]
}
