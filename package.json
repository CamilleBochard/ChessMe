    "move-matching": "tsx scripts/move-matching.ts",
    "base-model-sweep": "tsx scripts/base-model-sweep.ts",
    "opening-book": "tsx scripts/opening-book.ts",
    "bot-games": "tsx scripts/bot-games.ts"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "astro": "^7.3.4",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "onnxruntime-web": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
