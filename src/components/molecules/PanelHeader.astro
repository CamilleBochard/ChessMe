---
// The head of a section of the page: its name as a bracket label on the left,
// and on the right whatever the section adds, such as a note in micro text or
// a pair of buttons.
import BracketLabel from '../atoms/BracketLabel.astro';
import type { PageText } from '../../i18n/texts';

interface Props {
  /** The section's name, among the page's texts. */
  titleKey: PageText;
  /** The heading's id, for the section it names to be labelled by it. */
  id?: string;
}

const { titleKey, id } = Astro.props;
---

<div class="panel-header">
  <BracketLabel as="h2" textKey={titleKey} id={id} />
  <slot />
</div>

<style>
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
</style>
