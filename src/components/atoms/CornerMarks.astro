---
// Registration marks, as on a print proof: two small ink corners, top left and
// bottom right, set 8 px inside the region they are placed in. The region must
// be positioned (position: relative) for the marks to find its corners.
---

<span class="corner-marks" aria-hidden="true"></span>

<style>
  .corner-marks {
    position: absolute;
    inset: 8px;
    pointer-events: none;
  }

  .corner-marks::before,
  .corner-marks::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--ink);
  }

  .corner-marks::before {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .corner-marks::after {
    right: 0;
    bottom: 0;
    border-width: 0 1px 1px 0;
  }
</style>
