---
// The portfolio's way of naming a region of the page: a short label in Space
// Mono between square brackets, such as [Moves]. The brackets are drawn by the
// stylesheet and hidden from screen readers, which read the label alone. When
// it names a section it is rendered as that section's heading.
interface Props {
  text: string;
  as?: 'span' | 'h2' | 'p';
  id?: string;
}

const { text, as: Element = 'span', id } = Astro.props;
---

<Element class="bracket-label" id={id}>{text}</Element>

<style>
  .bracket-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink);
  }

  .bracket-label::before {
    content: '[' / '';
  }

  .bracket-label::after {
    content: ']' / '';
  }
</style>
