---
// The popup opened once a finished game has been stored, asking the visitor
// for their rating on Lichess or Chess.com, so the Bot's results can be read
// against the level of the players it met. It stands on the board, placed
// there by ChessBoard, and is no modal: the rest of the page stays free to
// scroll and use. Both fields are optional, and the cross or Escape closes it
// at once without sending anything. The game's
// script opens it, finds it by data-rating-dialog, reads the fields and
// sends what they hold.
import BracketLabel from '../atoms/BracketLabel.astro';
import GameButton from '../molecules/GameButton.astro';
import { TEXTS } from '../../i18n/texts';

const english = TEXTS.en.page;

const fields = [
  { name: 'lichess', textKey: 'lichessRating' },
  { name: 'chesscom', textKey: 'chesscomRating' },
] as const;
---

<dialog class="rating-dialog" data-rating-dialog aria-label={english.ratingTitle} data-text-label="ratingTitle">
  <!-- The page checks the fields itself, so the message is in its language
       rather than the browser's. -->
  <form method="dialog" novalidate data-rating-form>
    <div class="dialog-head">
      <BracketLabel as="p" textKey="ratingTitle" />
      <button
        type="button"
        class="dialog-close"
        data-rating-close
        aria-label={english.close}
        data-text-label="close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <p class="question" data-text="ratingQuestion">{english.ratingQuestion}</p>

    <div class="fields">
      {
        fields.map((field) => (
          <label>
            <span class="field-name" data-text={field.textKey}>
              {english[field.textKey]}
            </span>
            <input
              type="text"
              inputmode="numeric"
              name={field.name}
              autocomplete="off"
              maxlength="4"
              placeholder="1500"
              data-rating-field={field.name}
            />
          </label>
        ))
      }
    </div>

    <p class="problem" data-text="ratingProblem" data-rating-problem role="alert" hidden>{english.ratingProblem}</p>

    <div class="choices">
      <GameButton accent type="submit" textKey="send">{english.send}</GameButton>
    </div>
  </form>
</dialog>

<style>
  /* The look of the page's other dialogs, a light box bordered in ink,
     no larger than the board it stands on. */
  .rating-dialog {
    position: relative;
    width: min(340px, 100%);
    max-width: none;
    max-height: 100%;
    margin: 0;
    overflow-y: auto;
    padding: 16px;
    border: var(--line);
    border-radius: 0;
    background: var(--paper-light);
    color: var(--ink);
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .dialog-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .dialog-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    background: var(--accent);
    outline: none;
  }

  .question {
    margin: 0 0 14px;
    font-size: 13px;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  label {
    display: grid;
    gap: 4px;
  }

  .field-name {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  input {
    width: 100%;
    min-width: 0;
    padding: 8px;
    border: var(--line);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 16px;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .problem {
    margin: 10px 0 0;
    padding-left: 10px;
    border-left: 3px solid var(--accent);
    font-size: 12px;
  }

  .choices {
    display: flex;
    margin-top: 16px;
  }
</style>
