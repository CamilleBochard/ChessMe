---
import BracketLabel from '../atoms/BracketLabel.astro';
import EvaluationBar from '../molecules/EvaluationBar.astro';
import { TEXTS } from '../../i18n/texts';

// The board itself: the element Chessground draws into, the frame around it,
// and the dialog that asks which piece a pawn promotes to. Chessground keeps
// its base stylesheet for layout and dragging; everything it would take from a
// board or piece theme comes from the portfolio's look instead, below. The
// board is played and redrawn by the game's script, which finds the drawing
// element by data-board and the dialog by data-promotion. What the page puts
// in the slot, and the dialogs the script moves into data-board-overlay,
// stand over the board as part of the page, never blocking the rest of it.

const english = TEXTS.en.page;
---

<div class="board-surround">
  <EvaluationBar />
  <div class="board" data-board></div>
  <div class="board-overlay" data-board-overlay><slot /></div>
</div>

<dialog class="promotion" data-promotion aria-label={english.choosePromotion} data-text-label="choosePromotion">
  <form method="dialog">
    <div class="promotion-label">
      <BracketLabel as="p" textKey="promoteTo" />
    </div>
    <div class="promotion-choices">
      <button value="queen"><span class="piece-name" data-text="queen">{english.queen}</span></button>
      <button value="rook"><span class="piece-name" data-text="rook">{english.rook}</span></button>
      <button value="bishop"><span class="piece-name" data-text="bishop">{english.bishop}</span></button>
      <button value="knight"><span class="piece-name" data-text="knight">{english.knight}</span></button>
    </div>
  </form>
</dialog>

<style is:global>
  @import '@lichess-org/chessground/assets/chessground.base.css';

  /* Light squares in darker paper under fine ink hatching, and orange dark
     squares. Chessground draws no element per square, so the pattern is the
     board's background, in three layers from the top: a checkerboard that
     covers the dark squares, the hatching, then the paper showing through.
     The hatching keeps a 6 px step whatever the board's size. The top-left
     square of a board is light from either side. */
  .cg-wrap cg-board {
    background:
      conic-gradient(
          var(--square-dark) 0 25%,
          transparent 0 50%,
          var(--square-dark) 0 75%,
          transparent 0
        )
        0 0 / 25% 25%,
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--ink) 9%, transparent) 0 1px,
        transparent 1px 6px
      ),
      var(--square-light);
  }

  /* The marks drawn on squares are in ink: the accent would barely show on
     the orange squares. */
  .cg-wrap cg-board square.last-move {
    background-color: color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .cg-wrap cg-board square.selected {
    box-shadow: inset 0 0 0 3px var(--ink);
  }

  /* The king in check keeps the accent hatching, on light paper so that it
     reads on either colour of square. */
  .cg-wrap cg-board square.check {
    background:
      repeating-linear-gradient(-45deg, var(--accent) 0 2px, transparent 2px 6px),
      var(--paper-light);
  }

  /* An empty square a piece can go to: a filled octagon, 18% of the square. */
  .cg-wrap cg-board square.move-dest {
    display: grid;
    place-items: center;
    background: none;
  }

  .cg-wrap cg-board square.move-dest::after {
    content: '';
    width: 18%;
    height: 18%;
    background: var(--ink);
    clip-path: var(--octagon);
  }

  .cg-wrap cg-board square.move-dest:hover {
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* A piece that can be taken: four corners, 6% in from the square's edge,
     and nothing between them. Each corner is two ink strokes, 2 px thick
     and 28% of the mark long, one along each edge; each stroke is a
     one-colour gradient sized and placed in that corner. */
  .cg-wrap cg-board square.oc.move-dest::after {
    --stroke: linear-gradient(var(--ink), var(--ink));
    position: absolute;
    inset: 6%;
    width: auto;
    height: auto;
    clip-path: none;
    background:
      var(--stroke) top left / 28% 2px,
      var(--stroke) top left / 2px 28%,
      var(--stroke) top right / 28% 2px,
      var(--stroke) top right / 2px 28%,
      var(--stroke) bottom left / 28% 2px,
      var(--stroke) bottom left / 2px 28%,
      var(--stroke) bottom right / 28% 2px,
      var(--stroke) bottom right / 2px 28%;
    background-repeat: no-repeat;
  }

  /* Coordinates inside the board, in the corner of the squares along its
     edges: rank numbers top left of the left-hand column, file letters
     bottom right of the bottom row, in lowercase. Chessground's own places
     hang outside the board, which on a phone becomes sideways scroll. */
  .cg-wrap coords {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--ink-soft);
    opacity: 1;
  }

  .cg-wrap coords.ranks {
    top: 0;
    left: 0;
    width: 12.5%;
    height: 100%;
  }

  .cg-wrap coords.ranks coord {
    padding: 3px 4px;
    transform: none;
  }

  .cg-wrap coords.files {
    bottom: 0;
    left: 0;
    width: 100%;
    height: auto;
    text-transform: none;
    text-align: right;
  }

  .cg-wrap coords.files coord {
    flex: 1 1 0;
    padding: 0 4px 3px;
  }

  /* The pieces, from whichever set src/styles/piece-sets.css has in force,
     centred in their square at the size the set asks for. */
  .cg-wrap piece {
    background-size: var(--piece-size);
    background-position: center;
    background-repeat: no-repeat;
  }

  .cg-wrap piece.pawn.white { background-image: var(--piece-wP); }
  .cg-wrap piece.knight.white { background-image: var(--piece-wN); }
  .cg-wrap piece.bishop.white { background-image: var(--piece-wB); }
  .cg-wrap piece.rook.white { background-image: var(--piece-wR); }
  .cg-wrap piece.queen.white { background-image: var(--piece-wQ); }
  .cg-wrap piece.king.white { background-image: var(--piece-wK); }
  .cg-wrap piece.pawn.black { background-image: var(--piece-bP); }
  .cg-wrap piece.knight.black { background-image: var(--piece-bN); }
  .cg-wrap piece.bishop.black { background-image: var(--piece-bB); }
  .cg-wrap piece.rook.black { background-image: var(--piece-bR); }
  .cg-wrap piece.queen.black { background-image: var(--piece-bQ); }
  .cg-wrap piece.king.black { background-image: var(--piece-bK); }

  /* The first-visit entrance, started by the game's script: the board fades
     in, then the white pieces and the black ones drop onto their squares.
     Pieces are placed by Chessground through their transform, so the drop
     uses the separate translate property, which adds to it. The board only
     fades: scaling it would skew the bounds Chessground measures once for
     dragging. Under 1.4 s in all, the time the script keeps the class on. */
  @media (prefers-reduced-motion: no-preference) {
    .entering .cg-wrap {
      animation: board-appear 450ms ease-out both;
    }

    .entering piece {
      animation: piece-settle 550ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: 350ms;
    }

    .entering piece.black {
      animation-delay: 550ms;
    }
  }

  @keyframes board-appear {
    from {
      opacity: 0;
    }
  }

  @keyframes piece-settle {
    from {
      opacity: 0;
      translate: 0 -35%;
    }
  }
</style>

<style>
  /* The board's side: as large as fits between the two side columns and
     above the clocks and status on a wide screen, the screen's width less a
     margin on a phone. Chessground sizes itself to its element. The 670 px
     kept free across the screen are the game's 230 px and 320 px side
     columns and 120 px of room around the board; the 250 px kept free down
     it hold the title's bar, the two clocks and the status. */
  /* In analysis mode the evaluation bar takes its width from the board's,
     so the frame keeps its width and the clocks above and below theirs. */
  .board-surround {
    --board-size: min(640px, calc(100vw - 48px));
    --evaluation-bar-width: 10px;
    --bar-space: 0px;
    position: relative;
    display: flex;
    gap: 6px;
    padding: 6px;
    border: var(--line);
    background: var(--paper);
  }

  @media (min-width: 960px) {
    .board-surround {
      --board-size: min(640px, calc(100vw - 670px), calc(100vh - 250px));
      --evaluation-bar-width: 16px;
      gap: 10px;
      padding: 10px;
    }
  }

  .board-surround:has(:global(.evaluation-bar:not([hidden]))) {
    --bar-space: calc(var(--evaluation-bar-width) + 6px);
  }

  @media (min-width: 960px) {
    .board-surround:has(:global(.evaluation-bar:not([hidden]))) {
      --bar-space: calc(var(--evaluation-bar-width) + 10px);
    }
  }

  /* Centres what stands over the board. The layer itself lets clicks
     through to the board; only an open dialog in it takes them. */
  .board-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    padding: 8px;
    pointer-events: none;
  }

  /* The dialogs come from other components, so the selector reaches past
     this one's scope. */
  .board-overlay > :global(dialog[open]) {
    pointer-events: auto;
  }

  /* The second, dotted frame, 7 px outside the first. */
  .board-surround::before {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px dashed var(--ink-faint);
    pointer-events: none;
  }

  .board {
    width: calc(var(--board-size) - var(--bar-space));
    height: calc(var(--board-size) - var(--bar-space));
    border: var(--line);
  }

  /* The promotion dialog keeps its behaviour, a modal the arrow keys leave
     alone, and takes the look of the portfolio: a paper veil, a light box
     bordered in ink, and a button per piece that turns accent under the
     pointer or the keyboard. */
  .promotion {
    padding: 16px;
    border: var(--line);
    border-radius: 0;
    background: var(--paper-light);
    color: var(--ink);
  }

  .promotion::backdrop {
    background: color-mix(in srgb, var(--paper) 86%, transparent);
  }

  .promotion-label {
    margin-bottom: 12px;
    text-align: center;
  }

  .promotion-choices {
    display: flex;
    gap: 8px;
  }

  /* Each button shows the piece in the visitor's colour, which is the side
     the board is turned towards. Its name stays in the button for screen
     readers. */
  .promotion-choices button {
    width: 64px;
    height: 64px;
    padding: 0;
    border: var(--line);
    background-color: var(--paper);
    background-position: center;
    background-repeat: no-repeat;
    background-size: var(--piece-size);
    cursor: pointer;
  }

  /* Keyboard focus only: the dialog focuses its first button as it opens,
     and a plain :focus would light that one beside the button under the
     pointer. */
  .promotion-choices button:hover,
  .promotion-choices button:focus-visible {
    background-color: var(--accent);
    outline: none;
  }

  .piece-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .promotion-choices button[value='queen'] { background-image: var(--piece-wQ); }
  .promotion-choices button[value='rook'] { background-image: var(--piece-wR); }
  .promotion-choices button[value='bishop'] { background-image: var(--piece-wB); }
  .promotion-choices button[value='knight'] { background-image: var(--piece-wN); }

  :global(body:has(.cg-wrap.orientation-black)) .promotion-choices button[value='queen'] {
    background-image: var(--piece-bQ);
  }

  :global(body:has(.cg-wrap.orientation-black)) .promotion-choices button[value='rook'] {
    background-image: var(--piece-bR);
  }

  :global(body:has(.cg-wrap.orientation-black)) .promotion-choices button[value='bishop'] {
    background-image: var(--piece-bB);
  }

  :global(body:has(.cg-wrap.orientation-black)) .promotion-choices button[value='knight'] {
    background-image: var(--piece-bN);
  }
</style>
