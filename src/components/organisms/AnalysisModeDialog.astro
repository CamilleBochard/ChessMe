---
// The question asked before analysis mode is turned on: a picture of what it
// adds to the panel, the loss of each of the Bot's moves and its whole curve
// on the chart, and a warning that turned on during a game it shows where the
// Bot goes wrong, so the game is recorded as assisted. The game's script opens
// it from the analysis switch, finds it by data-analysis-dialog, and turns the
// mode on only when the dialog closes on the button valued "on".
import BracketLabel from '../atoms/BracketLabel.astro';
import GameButton from '../molecules/GameButton.astro';
import { TEXTS } from '../../i18n/texts';

const english = TEXTS.en.page;

// The picture's chart is a sketch, not a measurement: two made-up curves of
// the share of moves that lost at most so many centipawns, Camille's in ink
// and the Bot's in accent, drawn the way the panel's chart draws them.
const WIDTH = 220;
const HEIGHT = 90;
const MARGIN = 8;
const camilleShares = [0.4, 0.48, 0.56, 0.67, 0.78, 0.88, 0.93, 0.97, 0.99];
const botShares = [0.3, 0.36, 0.45, 0.55, 0.66, 0.78, 0.86, 0.93, 0.97];

function pointsOf(shares: number[]): string {
  const step = (WIDTH - 2 * MARGIN) / (shares.length - 1);
  const points: string[] = [];
  for (const [index, share] of shares.entries()) {
    const x = MARGIN + index * step;
    const y = MARGIN + (1 - share) * (HEIGHT - 2 * MARGIN);
    points.push(`${x},${y}`);
  }
  return points.join(' ');
}

const gridlines = [MARGIN, HEIGHT / 2, HEIGHT - MARGIN];
---

<dialog class="analysis-dialog" data-analysis-dialog aria-label={english.analysisMode} data-text-label="analysisMode">
  <form method="dialog">
    <div class="dialog-head">
      <BracketLabel as="p" textKey="analysisMode" />
      <button type="submit" value="cancel" class="dialog-close" aria-label={english.close} data-text-label="close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <figure class="preview" aria-hidden="true">
      <p class="preview-loss" data-text="analysisExampleLoss">{english.analysisExampleLoss}</p>
      <svg class="preview-chart" viewBox={`0 0 ${WIDTH} ${HEIGHT}`}>
        {gridlines.map((y) => <line class="gridline" x1={MARGIN} x2={WIDTH - MARGIN} y1={y} y2={y} />)}
        <polyline class="curve camille" points={pointsOf(camilleShares)} />
        <polyline class="curve bot" points={pointsOf(botShares)} />
      </svg>
    </figure>

    <p class="what-it-shows" data-text="analysisShows">{english.analysisShows}</p>
    <p class="warning" data-text="analysisWarning">{english.analysisWarning}</p>

    <div class="choices">
      <GameButton accent type="submit" value="on" textKey="turnOn">{english.turnOn}</GameButton>
      <GameButton type="submit" value="cancel" textKey="cancel">{english.cancel}</GameButton>
    </div>
  </form>
</dialog>

<style>
  /* The look of the page's other dialogs: a paper veil, a light box
     bordered in ink. */
  .analysis-dialog {
    width: min(380px, calc(100vw - 32px));
    max-width: none;
    padding: 16px;
    border: var(--line);
    border-radius: 0;
    background: var(--paper-light);
    color: var(--ink);
  }

  .analysis-dialog::backdrop {
    background: color-mix(in srgb, var(--paper) 86%, transparent);
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .dialog-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .dialog-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    background: var(--accent);
    outline: none;
  }

  .preview {
    margin: 0 0 14px;
    padding: 12px;
    border: var(--line);
    background: var(--paper);
  }

  .preview-loss {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .preview-chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .gridline {
    stroke: var(--ink-faint);
    stroke-width: 1;
  }

  .curve {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .curve.camille {
    stroke: var(--ink);
  }

  .curve.bot {
    stroke: var(--accent);
  }

  p {
    margin: 0 0 10px;
    font-size: 13px;
  }

  .warning {
    padding-left: 10px;
    border-left: 3px solid var(--accent);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
</style>
