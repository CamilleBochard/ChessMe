  }

  .stage-foot {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .stage-foot :global(.foot-band) {
    flex: 1 1 3rem;
    height: 10px;
    opacity: 0.8;
  }

  .side-section {
    padding: 18px 20px;
    border-bottom: var(--line);
  }

  .side-section:last-child {
    border-bottom: 0;
  }

  /* On a phone the settings and the pieces are dialogs over the board, and
     only the buttons of a game in progress show here, under the board. */
  .settings .side-section {
    padding: 0 16px;
    border-bottom: 0;
  }

  .settings .controls:has([data-controls]:not([hidden])) {
    padding-bottom: 16px;
  }

  .settings :global(.corner-marks) {
    display: none;
  }

  /* The section that runs the game carries the registration marks, as the
     portfolio marks the region a visitor acts in. */
  .controls {
    position: relative;
  }

  .after-game {
    display: grid;
    gap: 20px;
  }

  /* The question and the summary of the site's games only appear once a
     game has ended; until then their section takes no room. Astro may place
     a component's script beside it, which never counts as shown. */
  .after-game:not(:has(> :not([hidden], script))) {
    display: none;
  }

  @media (min-width: 960px) {
    .game {
      display: grid;
      grid-template-columns: 230px minmax(0, 1fr) 320px;
