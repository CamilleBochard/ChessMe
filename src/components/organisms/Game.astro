     moves and the panel on the right at 320px, and the board centred
     between them. */
  .game {
    display: flex;
    flex-direction: column;
  }

  .stage {
    order: 1;
    display: grid;
    grid-template-columns: min-content;
    justify-content: center;
    gap: 12px;
    padding: 20px 16px 16px;
  }

  .settings {
    order: 2;
  }

  .record {
    order: 3;
    border-top: var(--line);
    background: var(--paper);
  }

  .stage-head {
