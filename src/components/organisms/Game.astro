      overflow-y: auto;
    }

    .settings .side-section {
      padding: 18px 20px;
      border-bottom: var(--line);
    }

    .settings :global(.corner-marks) {
      display: block;
    }

    .record {
      border-top: 0;
      border-left: var(--line);
      overflow-y: auto;
    }

    /* The moves stay at the top of their column while the panel scrolls
       under them, so the history can always be walked. */
    .moves {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--paper);
    }
  }
</style>
