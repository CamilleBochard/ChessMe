---
// Camille's record over the games the Bot is built from: how many he played,
// with each colour, how they went, and the openings he plays most with each.
// The figures come as they are from pipeline/build_player_record.py; this
// component only places them, in a dialog shown in place on a wide screen
// and over the board on a phone, where any button marked data-open-record
// opens it. Scores are written by the script below, in the page's language.
import BracketLabel from '../atoms/BracketLabel.astro';
import MicroText from '../atoms/MicroText.astro';
import AdaptiveDialog from '../molecules/AdaptiveDialog.astro';
import { TEXTS } from '../../i18n/texts';
import record from '../../record/player-record.json';

const english = TEXTS.en.page;

interface Results {
  wins: number;
  draws: number;
  losses: number;
}

/** A player's score: a point for a win and half a point for a draw, as a share of the games. */
function score(results: Results): number {
  const games = results.wins + results.draws + results.losses;
  return (results.wins + results.draws / 2) / games;
}

/** A share as a whole percentage, as English writes it; the script rewrites it in the page's language. */
function percent(share: number): string {
  return `${Math.round(share * 100)}%`;
}

const colours = [
  { key: 'white', titleKey: 'withWhite', record: record.white },
  { key: 'black', titleKey: 'withBlack', record: record.black },
] as const;

const outcomes = [
  { key: 'wins', count: record.results.wins },
  { key: 'draws', count: record.results.draws },
  { key: 'losses', count: record.results.losses },
] as const;
---

<AdaptiveDialog titleKey="record" data-record-dialog>
  <div class="player-record">
    <div class="in-place-title">
      <BracketLabel as="p" textKey="record" />
    </div>

    <p class="total">
      <span class="total-figure">{record.games}</span>
      <span class="total-unit" data-text="games">{english.games}</span>
    </p>

    <dl class="by-colour">
      {
        colours.map((colour) => (
          <div>
            <dt data-text={colour.titleKey}>{english[colour.titleKey]}</dt>
            <dd>{colour.record.games}</dd>
          </div>
        ))
      }
    </dl>

    <div class="results">
      <div class="results-bar" aria-hidden="true">
        {outcomes.map((outcome) => <span class={outcome.key} style={`flex-grow: ${outcome.count}`} />)}
      </div>
      <dl class="results-counts">
        {
          outcomes.map((outcome) => (
            <div class={outcome.key}>
              <dt data-text={outcome.key}>{english[outcome.key]}</dt>
              <dd>{outcome.count}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      colours.map((colour) => (
        <table class="openings">
          <caption>
            <span data-text="mostPlayedOpenings">{english.mostPlayedOpenings}</span>,{' '}
            <span class="colour-name" data-text={colour.titleKey}>
              {english[colour.titleKey]}
            </span>
          </caption>
          <thead>
            <tr>
              <th scope="col" data-text="opening">
                {english.opening}
              </th>
              <th scope="col" data-text="games">
                {english.games}
              </th>
              <th scope="col" data-text="score">
                {english.score}
              </th>
            </tr>
          </thead>
          <tbody>
            {colour.record.openings.map((opening) => (
              <tr>
                <td>{opening.name}</td>
                <td>{opening.games}</td>
                <td data-share={score(opening.results)}>{percent(score(opening.results))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ))
    }

    <MicroText as="p" class="scope" textKey="recordScope">{english.recordScope}</MicroText>
  </div>
</AdaptiveDialog>

<script>
  import { adaptiveDialog } from '../adaptive-dialog';
  import { LANGUAGE_CHANGED, pageTexts } from '../../i18n/page-language';

  const dialog = adaptiveDialog(document.querySelector<HTMLDialogElement>('[data-record-dialog]')!, true);
  for (const opener of document.querySelectorAll<HTMLButtonElement>('[data-open-record]')) {
    opener.addEventListener('click', () => {
      dialog.openOnPhone();
    });
  }

  showScores();
  document.addEventListener(LANGUAGE_CHANGED, showScores);

  /** Writes each score as a percentage the page's language's way. */
  function showScores(): void {
    const texts = pageTexts();
    for (const cell of document.querySelectorAll<HTMLElement>('[data-share]')) {
      cell.textContent = texts.percent(Number(cell.dataset.share), 0);
    }
  }
</script>

<style>
  /* One column no wider than the dialog: the left-hand column of a wide
     screen is narrow, and the tables must wrap their names to fit it. */
  .player-record {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  /* On a phone the dialog's own head names the record. */
  .in-place-title {
    display: none;
  }

  @media (min-width: 960px) {
    .in-place-title {
      display: block;
    }
  }

  .total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin: 0;
  }

  .total-figure {
    font-family: var(--font-title);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .total-unit {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  dl {
    margin: 0;
  }

  dd {
    margin: 0;
  }

  .by-colour {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .by-colour dt,
  .results-counts dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .by-colour dd {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
  }

  /* Wins, draws and losses as one bar, each part as long as its count. */
  .results-bar {
    display: flex;
    height: 10px;
    border: var(--line);
  }

  .results-bar .wins {
    background: var(--accent);
  }

  .results-bar .draws {
    background: var(--paper-light);
  }

  .results-bar .losses {
    background: var(--ink);
  }

  .results-counts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 6px;
  }

  .results-counts dd {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .results-counts .wins dd {
    color: var(--accent);
  }

  .openings {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 12px;
  }

  .openings th:nth-child(2),
  .openings th:nth-child(3) {
    width: 4.5em;
  }

  .openings caption {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .openings .colour-name {
    color: var(--ink);
  }

  .openings th {
    padding: 0 0 4px;
    border-bottom: var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    text-align: right;
    color: var(--ink-soft);
  }

  .openings td {
    padding: 4px 0;
    border-bottom: 1px solid var(--ink-faint);
    font-family: var(--font-mono);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .openings th:first-child,
  .openings td:first-child {
    padding-right: 8px;
    font-family: var(--font-body);
    text-align: left;
  }

  .openings td + td,
  .openings th + th {
    padding-left: 8px;
  }

  .scope {
    margin: 0;
  }
</style>
