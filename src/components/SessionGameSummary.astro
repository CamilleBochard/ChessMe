---
// The Session Game summary: how many games visitors have finished on the site,
// the Bot's record in them, and what visitors made of it. The figures are read
// from the Session Game service; this component only places them on the page,
// in the page's language.
import { TEXTS, type PageText } from '../i18n/texts';

interface Props {
  /**
   * When the counts are read: as the page opens, or each time a game on the
   * page ends, when the summary first appears and the counts have just changed.
   */
  readOn: 'page-load' | 'game-end';
  /** A heading for the summary, named among the page's texts, for a page that does not introduce it in its own words. */
  titleKey?: PageText;
}

const { readOn, titleKey } = Astro.props;
// Written in English here; the page's script rewrites every data-text in the
// visitor's language.
const english = TEXTS.en.page;
const hiddenUntilAGameEnds = readOn === 'game-end';
---

<section class="session-game-summary" data-session-game-summary data-read-on={readOn} hidden={hiddenUntilAGameEnds}>
  {titleKey !== undefined && <h2 data-text={titleKey}>{english[titleKey]}</h2>}
  <p data-summary-status data-text="readingTheCounts">{english.readingTheCounts}</p>
  <dl hidden data-summary-figures>
    <dt data-text="gamesFinished">{english.gamesFinished}</dt>
    <dd data-figure="games"></dd>
    <dt data-text="botRecord">{english.botRecord}</dt>
    <dd data-figure="botRecord"></dd>
    <dt data-text="botScore">{english.botScore}</dt>
    <dd data-figure="botScore" data-text="noGameYet">{english.noGameYet}</dd>
    <dt data-text="fromOpeningBook">{english.fromOpeningBook}</dt>
    <dd data-figure="fromOpeningBook" data-text="noMoveYet">{english.noMoveYet}</dd>
    <dt data-text="feltReal">{english.feltReal}</dt>
    <dd data-figure="feltLikeARealPlayer" data-text="noAnswerYet">{english.noAnswerYet}</dd>
  </dl>
</section>

<script>
  import {
    readSessionGameSummary,
    SESSION_GAMES_CHANGED,
    type SessionGameSummary,
  } from '../telemetry/session-game-summary';
  import { LANGUAGE_CHANGED, pageLanguage, pageTexts } from '../i18n/page-language';

  const summaries = document.querySelectorAll<HTMLElement>('[data-session-game-summary]');
  for (const summary of summaries) {
    if (summary.dataset.readOn === 'game-end') {
      document.addEventListener(SESSION_GAMES_CHANGED, () => {
        summary.hidden = false;
        void showSummary(summary);
      });
    } else {
      void showSummary(summary);
    }
    // The figures are written in the page's language, so a summary on show
    // is read again in the new one.
    document.addEventListener(LANGUAGE_CHANGED, () => {
      if (!summary.hidden) {
        void showSummary(summary);
      }
    });
  }

  async function showSummary(container: HTMLElement): Promise<void> {
    const status = container.querySelector<HTMLElement>('[data-summary-status]')!;
    const figures = container.querySelector<HTMLElement>('[data-summary-figures]')!;

    const summary = await readSessionGameSummary(fetch, pageLanguage());
    if (summary === undefined) {
      status.textContent = pageTexts().summaryUnavailable;
      status.hidden = false;
      figures.hidden = true;
      return;
    }

    // A figure the summary leaves out, such as the score before any game, keeps
    // the wording already on the page.
    for (const figure of figures.querySelectorAll<HTMLElement>('[data-figure]')) {
      const name = figure.dataset.figure as keyof SessionGameSummary;
      const value = summary[name];
      if (value !== undefined) {
        figure.textContent = value;
        // A figure now shown is no longer the placeholder a language switch rewrites.
        delete figure.dataset.text;
      }
    }
    status.hidden = true;
    figures.hidden = false;
  }
</script>

<style>
  h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  p {
    margin: 0;
  }

  /* Only a shown list is laid out as a grid: a display set here would
     otherwise override the hidden attribute and show an empty list. */
  dl:not([hidden]) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  dt {
    opacity: 0.75;
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
