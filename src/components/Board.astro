---
// A chessboard where the visitor plays one side and the Bot plays the other,
// with the controls around a game: choosing a side, taking back, resigning,
// starting over, and the list of moves so far. The rules live in src/game/,
// the Bot's choice in src/engine/ and what the visitor may do when in
// src/session/; this component only translates between them, chessground
// (which draws the board and handles dragging and clicking) and a few buttons.
---

<div class="board-frame" data-board-frame>
  <div class="play">
    <div class="board"></div>
    <p class="status" data-status aria-live="polite"></p>

    <div class="buttons" data-setup>
      <span class="buttons-label">Play as</span>
      <button type="button" class="brand" data-play-as="white">White</button>
      <button type="button" class="brand" data-play-as="black">Black</button>
    </div>

    <div class="buttons" data-controls hidden>
      <button type="button" data-take-back>Take back</button>
      <button type="button" data-resign>Resign</button>
      <button type="button" data-new-game>New game</button>
    </div>
  </div>

  <aside class="moves">
    <h2 id="moves-heading">Moves</h2>
    <ol class="move-list" data-move-list aria-labelledby="moves-heading"></ol>
  </aside>

  <dialog class="promotion" data-promotion aria-label="Choose a promotion piece">
    <form method="dialog">
      <p>Promote to</p>
      <div class="promotion-choices">
        <button value="queen">Queen</button>
        <button value="rook">Rook</button>
        <button value="bishop">Bishop</button>
        <button value="knight">Knight</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { Chessground } from '@lichess-org/chessground';
  import type { Key } from '@lichess-org/chessground/types';
  import type { SquareName } from 'chessops/types';
  import type { Colour } from '../board/starting-position';
  import {
    currentFen,
    isInCheck,
    isPromotion,
    legalDestinations,
    moveList,
    sideToMove,
    type MoveListRow,
    type MoveRequest,
    type PromotionPiece,
  } from '../game/game';
  import { gameStatus } from '../game/game-status';
  import { selectMove } from '../engine/move-selection';
  import { createSessionGame } from '../session/session-game';

  // Astro bundles this script once per page, however many times the component
  // is used, so it has to set up every board on the page rather than the first
  // one it finds.
  const frames = document.querySelectorAll<HTMLElement>('[data-board-frame]');
  for (const frame of frames) {
    setUpBoard(frame);
  }

  /**
   * Wires one board and its controls to a Session Game. The board opens on the
   * starting position and waits for the visitor to pick a side; New game
   * brings it back there.
   */
  function setUpBoard(frame: HTMLElement): void {
    const boardElement = frame.querySelector<HTMLElement>('.board')!;
    const statusElement = frame.querySelector<HTMLElement>('[data-status]')!;
    const setupElement = frame.querySelector<HTMLElement>('[data-setup]')!;
    const controlsElement = frame.querySelector<HTMLElement>('[data-controls]')!;
    const takeBackButton = frame.querySelector<HTMLButtonElement>('[data-take-back]')!;
    const resignButton = frame.querySelector<HTMLButtonElement>('[data-resign]')!;
    const newGameButton = frame.querySelector<HTMLButtonElement>('[data-new-game]')!;
    const moveListElement = frame.querySelector<HTMLOListElement>('[data-move-list]')!;
    const promotionDialog = frame.querySelector<HTMLDialogElement>('[data-promotion]')!;

    const session = createSessionGame({
      chooseMove: (fen) => selectMove(fen),
      onChange: () => {
        showGame();
      },
    });

    const board = Chessground(boardElement, {
      orientation: 'white',
      coordinates: true,
      premovable: { enabled: false },
      movable: {
        free: false,
        showDests: true,
        events: {
          after: (from, to) => {
            void onVisitorMove(from, to);
          },
        },
      },
    });
    showGame();

    for (const button of frame.querySelectorAll<HTMLButtonElement>('[data-play-as]')) {
      button.addEventListener('click', () => {
        const colour = button.dataset.playAs as Colour;
        board.set({ orientation: colour });
        void session.start(colour);
      });
    }

    takeBackButton.addEventListener('click', () => {
      session.takeBack();
    });

    resignButton.addEventListener('click', () => {
      session.resign();
    });

    newGameButton.addEventListener('click', () => {
      session.startOver();
    });

    async function onVisitorMove(from: Key, to: Key): Promise<void> {
      // Chessground only lets a piece go to a square from legalDestinations,
      // which never contains its 'a0' placeholder, so both keys are real squares.
      const move: MoveRequest = {
        from: from as SquareName,
        to: to as SquareName,
      };

      if (isPromotion(session.game(), move.from, move.to)) {
        const piece = await askPromotionPiece(promotionDialog);
        if (piece === null) {
          // The visitor closed the dialog: take the pawn back to its square.
          showGame();
          return;
        }
        move.promotion = piece;
      }

      const accepted = await session.playVisitorMove(move);
      if (!accepted) {
        // Refused: redraw the current game, which puts the piece back.
        showGame();
      }
    }

    /**
     * Draws the game on the board, states whose turn it is or how it ended,
     * and enables only the controls the session allows right now. Redrawing
     * from the game after every move matters even for a legal one: chessground
     * moved only the piece that was dragged, so a pawn taken en passant or a
     * promoted pawn would otherwise still show its old state.
     */
    function showGame(): void {
      const game = session.game();
      const visitor = session.visitor();
      const isOngoing = gameStatus(game).kind === 'ongoing';
      const isVisitorsTurn = sideToMove(game) === visitor;

      let lastMove: Key[] | undefined = undefined;
      if (game.lastMove !== undefined) {
        lastMove = [game.lastMove.from, game.lastMove.to];
      }

      // Only the visitor's pieces can be moved, and only on the visitor's turn.
      let movableColour: Colour | undefined = undefined;
      if (visitor !== null && isOngoing && isVisitorsTurn) {
        movableColour = visitor;
      }

      board.set({
        fen: currentFen(game),
        turnColor: sideToMove(game),
        lastMove: lastMove,
        check: isInCheck(game),
        movable: {
          color: movableColour,
          dests: legalDestinations(game),
        },
      });

      const hasStarted = visitor !== null;
      setupElement.hidden = hasStarted;
      controlsElement.hidden = !hasStarted;
      statusElement.textContent = session.status();
      takeBackButton.disabled = !session.canTakeBack();
      resignButton.disabled = !session.canResign();

      showMoveList(moveListElement, moveList(game));
    }
  }

  /**
   * Writes the moves so far as numbered rows, marks the latest move so the eye
   * finds it, and keeps it in view.
   */
  function showMoveList(listElement: HTMLOListElement, rows: MoveListRow[]): void {
    const items: HTMLLIElement[] = [];
    let latestMove: HTMLSpanElement | null = null;

    for (const row of rows) {
      const whiteMove = moveListCell('move', row.white ?? '…');
      const blackMove = moveListCell('move', row.black ?? '');

      const item = document.createElement('li');
      item.append(moveListCell('move-number', `${row.moveNumber}.`), whiteMove, blackMove);
      items.push(item);

      if (row.black !== null) {
        latestMove = blackMove;
      } else {
        latestMove = whiteMove;
      }
    }

    if (latestMove !== null) {
      latestMove.classList.add('latest');
    }
    listElement.replaceChildren(...items);
    listElement.scrollTop = listElement.scrollHeight;
  }

  function moveListCell(className: string, text: string): HTMLSpanElement {
    const cell = document.createElement('span');
    cell.className = className;
    cell.textContent = text;
    return cell;
  }

  /** Opens the promotion dialog and resolves with the chosen piece, or null if it was dismissed. */
  function askPromotionPiece(dialog: HTMLDialogElement): Promise<PromotionPiece | null> {
    return new Promise((resolve) => {
      dialog.returnValue = '';
      dialog.addEventListener(
        'close',
        () => {
          const choice = dialog.returnValue;
          if (choice === 'queen' || choice === 'rook' || choice === 'bishop' || choice === 'knight') {
            resolve(choice);
          } else {
            resolve(null);
          }
        },
        { once: true },
      );
      dialog.showModal();
    });
  }
</script>

<style is:global>
  @import '@lichess-org/chessground/assets/chessground.base.css';
  @import '@lichess-org/chessground/assets/chessground.brown.css';
  @import '@lichess-org/chessground/assets/chessground.cburnett.css';

  /* Chessground's stock coordinates hang outside the board: the file letters
     sit at left: 24px with width: 100%, so they run 24px past the right edge,
     and the rank digits sit at top: -20px. On a phone that overhang becomes
     horizontal page scroll, and the file letters land under the wrong files.
     Pull both back inside the board. */
  .board-frame .cg-wrap coords.files {
    left: 0;
  }

  .board-frame .cg-wrap coords.ranks {
    top: 0;
  }
</style>

<style>
  /* On a phone everything stacks: board, controls, then the moves. From
     960px the moves move into their own column on the right, behind a divider
     line, and the whole thing fits the screen height without scrolling. */
  .board-frame {
    display: grid;
    gap: 1.5rem;
  }

  .play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* Chessground sizes itself to its container, so the container is where the
     responsive behaviour belongs. */
  .board {
    width: 100%;
    max-width: 40rem;
    aspect-ratio: 1;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    text-align: center;
    font-weight: 600;
    color: var(--text-1);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .buttons[hidden] {
    display: none;
  }

  .buttons-label {
    margin-right: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-2);
  }

  /* Pill buttons on a soft grey, with the brand colour kept for the one
     choice that starts a game. */
  .buttons button,
  .promotion-choices button {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 2.25rem;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: 1.25rem;
    background: var(--default-soft);
    color: var(--text-1);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .buttons button:hover:not(:disabled),
  .promotion-choices button:hover {
    border-color: var(--brand);
  }

  .buttons button.brand {
    background: var(--brand);
    color: var(--brand-contrast);
  }

  .buttons button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .moves {
    border-top: 1px solid var(--divider);
    padding-top: 1.25rem;
  }

  .moves h2 {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-1);
  }

  /* Three columns, number then White then Black, like a scoresheet. Its rows
     are created by the script, which Astro's scoping cannot see, hence
     :global for everything inside the list. */
  .move-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 12rem;
    overflow-y: auto;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
  }

  .move-list :global(li) {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1fr;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .move-list :global(li:nth-child(odd)) {
    background: var(--bg-soft);
  }

  .move-list :global(.move-number) {
    color: var(--text-3);
  }

  .move-list :global(.latest) {
    color: var(--brand);
    font-weight: 600;
  }

  @media (min-width: 960px) {
    /* The play area and the moves become columns of the page's own grid, so
       the page can set the title right against the board's left edge. */
    .board-frame {
      display: contents;
    }

    .play {
      padding: 2rem 2rem 2rem 0;
      min-height: 0;
    }

    /* As large as the screen height allows while leaving room under the board
       for the status line and one row of buttons, so the controls never fall
       below the fold. On a wide but short screen the width caps it instead,
       keeping room for the title column (14rem), the moves column (17rem) and
       the padding around the board. */
    .board {
      width: min(calc(100dvh - 9.5rem), calc(100vw - 17rem - 14rem - 2rem));
      max-width: none;
    }

    .moves {
      display: flex;
      flex-direction: column;
      min-height: 0;
      border-top: none;
      border-left: 1px solid var(--divider);
      padding: 2rem 1.5rem;
    }

    .move-list {
      flex: 1;
      max-height: none;
    }
  }

  .promotion {
    border: 1px solid var(--divider);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    color: var(--text-1);
  }

  .promotion::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .promotion p {
    margin: 0 0 0.75rem;
    text-align: center;
    font-weight: 600;
  }

  .promotion-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(6rem, 1fr));
    gap: 0.5rem;
  }
</style>
