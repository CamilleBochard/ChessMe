---
// A chessboard where the visitor plays one side and the Bot plays the other,
// with the controls around a game: choosing a side, taking back, resigning,
// starting over, and the list of moves so far. The rules live in src/game/
// and the Bot's choice in src/engine/; this component only translates between
// them, chessground (which draws the board and handles dragging and clicking)
// and a few buttons.
---

<div class="board-frame" data-board-frame>
  <div class="board"></div>
  <p class="status" data-status aria-live="polite"></p>

  <div class="setup" data-setup>
    <p>Play as</p>
    <div class="buttons">
      <button type="button" data-play-as="white">White</button>
      <button type="button" data-play-as="black">Black</button>
    </div>
  </div>

  <div class="buttons" data-controls hidden>
    <button type="button" data-take-back>Take back</button>
    <button type="button" data-resign>Resign</button>
    <button type="button" data-new-game>New game</button>
  </div>

  <ol class="move-list" data-move-list aria-label="Moves played"></ol>

  <dialog class="promotion" data-promotion aria-label="Choose a promotion piece">
    <form method="dialog">
      <p>Promote to</p>
      <div class="promotion-choices">
        <button value="queen">Queen</button>
        <button value="rook">Rook</button>
        <button value="bishop">Bishop</button>
        <button value="knight">Knight</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { Chessground } from '@lichess-org/chessground';
  import type { Key } from '@lichess-org/chessground/types';
  import type { SquareName } from 'chessops/types';
  import type { Colour } from '../board/starting-position';
  import {
    currentFen,
    isInCheck,
    isPromotion,
    legalDestinations,
    moveList,
    newGame,
    playMove,
    resign,
    sideToMove,
    takeBack,
    type MoveListRow,
    type MoveRequest,
    type PromotionPiece,
  } from '../game/game';
  import { describeTurn, gameStatus } from '../game/game-status';
  import { selectMove } from '../engine/move-selection';

  // Astro bundles this script once per page, however many times the component
  // is used, so it has to set up every board on the page rather than the first
  // one it finds.
  const frames = document.querySelectorAll<HTMLElement>('[data-board-frame]');
  for (const frame of frames) {
    setUpBoard(frame);
  }

  /**
   * Wires one board and its controls. The board opens on the starting position
   * and waits for the visitor to pick a side; New game brings it back there.
   */
  function setUpBoard(frame: HTMLElement): void {
    const boardElement = frame.querySelector<HTMLElement>('.board')!;
    const statusElement = frame.querySelector<HTMLElement>('[data-status]')!;
    const setupElement = frame.querySelector<HTMLElement>('[data-setup]')!;
    const controlsElement = frame.querySelector<HTMLElement>('[data-controls]')!;
    const takeBackButton = frame.querySelector<HTMLButtonElement>('[data-take-back]')!;
    const resignButton = frame.querySelector<HTMLButtonElement>('[data-resign]')!;
    const newGameButton = frame.querySelector<HTMLButtonElement>('[data-new-game]')!;
    const moveListElement = frame.querySelector<HTMLOListElement>('[data-move-list]')!;
    const promotionDialog = frame.querySelector<HTMLDialogElement>('[data-promotion]')!;

    let game = newGame();
    let playerColour: Colour = 'white';
    let hasStarted = false;

    const board = Chessground(boardElement, {
      orientation: playerColour,
      coordinates: true,
      premovable: { enabled: false },
      movable: {
        free: false,
        showDests: true,
        events: {
          after: (from, to) => {
            void onPlayerMove(from, to);
          },
        },
      },
    });
    showGame();

    for (const button of frame.querySelectorAll<HTMLButtonElement>('[data-play-as]')) {
      button.addEventListener('click', () => {
        const colour = button.dataset.playAs as Colour;
        startGame(colour);
      });
    }

    takeBackButton.addEventListener('click', () => {
      const earlier = takeBack(game, playerColour);
      if (earlier === null) {
        return;
      }
      game = earlier;
      showGame();
    });

    resignButton.addEventListener('click', () => {
      game = resign(game, playerColour);
      showGame();
    });

    newGameButton.addEventListener('click', () => {
      // Back to the starting position and the choice of side. A Bot reply
      // still being computed for the old game is dropped by playBotMove.
      game = newGame();
      hasStarted = false;
      showGame();
    });

    function startGame(colour: Colour): void {
      playerColour = colour;
      game = newGame();
      hasStarted = true;
      board.set({ orientation: playerColour });
      showGame();

      if (sideToMove(game) !== playerColour) {
        void playBotMove();
      }
    }

    async function onPlayerMove(from: Key, to: Key): Promise<void> {
      // Chessground only lets a piece go to a square from legalDestinations,
      // which never contains its 'a0' placeholder, so both keys are real squares.
      const move: MoveRequest = {
        from: from as SquareName,
        to: to as SquareName,
      };

      if (isPromotion(game, move.from, move.to)) {
        const piece = await askPromotionPiece(promotionDialog);
        if (piece === null) {
          // The player closed the dialog: take the pawn back to its square.
          showGame();
          return;
        }
        move.promotion = piece;
      }

      const next = playMove(game, move);
      if (next === null) {
        // Refused: redraw the current game, which puts the piece back.
        showGame();
        return;
      }

      game = next;
      // Redraw from the game even after a legal move: chessground moved only
      // the piece that was dragged, so a pawn taken en passant or a promoted
      // pawn would otherwise still show its old state.
      showGame();

      if (gameStatus(game).kind === 'ongoing') {
        await playBotMove();
      }
    }

    /** Asks the engine for the Bot's reply and plays it. */
    async function playBotMove(): Promise<void> {
      const askedAbout = game;
      const reply = await selectMove(currentFen(askedAbout));

      // While the engine was choosing, the visitor may have resigned or
      // started a new game. The reply answers a game that is gone.
      if (game !== askedAbout) {
        return;
      }

      const next = playMove(game, reply);
      if (next === null) {
        throw new Error(`The engine chose an illegal move: ${reply.from}-${reply.to} in ${currentFen(game)}`);
      }

      game = next;
      showGame();
    }

    /**
     * Draws the game on the board, states whose turn it is or how it ended,
     * and enables only the controls that make sense right now. Only the
     * visitor's pieces can be moved, and only on the visitor's turn.
     */
    function showGame(): void {
      const status = gameStatus(game);
      const isOver = status.kind !== 'ongoing';
      const isPlayersTurn = sideToMove(game) === playerColour;
      const isBotThinking = hasStarted && !isOver && !isPlayersTurn;

      let lastMove: Key[] | undefined = undefined;
      if (game.lastMove !== undefined) {
        lastMove = [game.lastMove.from, game.lastMove.to];
      }

      let movableColour: Colour | undefined = undefined;
      if (hasStarted && !isOver && isPlayersTurn) {
        movableColour = playerColour;
      }

      board.set({
        fen: currentFen(game),
        turnColor: sideToMove(game),
        lastMove: lastMove,
        check: isInCheck(game),
        movable: {
          color: movableColour,
          dests: legalDestinations(game),
        },
      });

      setupElement.hidden = hasStarted;
      controlsElement.hidden = !hasStarted;

      if (hasStarted) {
        statusElement.textContent = describeTurn(game, playerColour);
      } else {
        statusElement.textContent = 'Choose a side to start.';
      }

      // Taking back waits for the Bot's reply, so the reply is taken back with
      // the move it answers. A resignation is final.
      const hasMoveToTakeBack = takeBack(game, playerColour) !== null;
      const isResigned = status.kind === 'resignation';
      takeBackButton.disabled = isBotThinking || isResigned || !hasMoveToTakeBack;
      resignButton.disabled = isOver;

      showMoveList(moveListElement, moveList(game));
    }
  }

  /** Writes the moves so far as numbered rows and keeps the latest one in view. */
  function showMoveList(listElement: HTMLOListElement, rows: MoveListRow[]): void {
    const items: HTMLLIElement[] = [];
    for (const row of rows) {
      const item = document.createElement('li');
      item.append(
        moveListCell('move-number', `${row.moveNumber}.`),
        moveListCell('move', row.white ?? '…'),
        moveListCell('move', row.black ?? ''),
      );
      items.push(item);
    }
    listElement.replaceChildren(...items);
    listElement.scrollTop = listElement.scrollHeight;
  }

  function moveListCell(className: string, text: string): HTMLSpanElement {
    const cell = document.createElement('span');
    cell.className = className;
    cell.textContent = text;
    return cell;
  }

  /** Opens the promotion dialog and resolves with the chosen piece, or null if it was dismissed. */
  function askPromotionPiece(dialog: HTMLDialogElement): Promise<PromotionPiece | null> {
    return new Promise((resolve) => {
      dialog.returnValue = '';
      dialog.addEventListener(
        'close',
        () => {
          const choice = dialog.returnValue;
          if (choice === 'queen' || choice === 'rook' || choice === 'bishop' || choice === 'knight') {
            resolve(choice);
          } else {
            resolve(null);
          }
        },
        { once: true },
      );
      dialog.showModal();
    });
  }
</script>

<style is:global>
  @import '@lichess-org/chessground/assets/chessground.base.css';
  @import '@lichess-org/chessground/assets/chessground.brown.css';
  @import '@lichess-org/chessground/assets/chessground.cburnett.css';

  /* Chessground's stock coordinates hang outside the board: the file letters
     sit at left: 24px with width: 100%, so they run 24px past the right edge,
     and the rank digits sit at top: -20px. On a phone that overhang becomes
     horizontal page scroll, and the file letters land under the wrong files.
     Pull both back inside the board. */
  .board-frame .cg-wrap coords.files {
    left: 0;
  }

  .board-frame .cg-wrap coords.ranks {
    top: 0;
  }
</style>

<style>
  /* The frame caps the board on wide screens and lets it shrink on a phone.
     Chessground sizes itself to its container, so the container is where the
     responsive behaviour belongs. */
  .board-frame {
    width: 100%;
    max-width: min(90vh, 40rem);
    margin-inline: auto;
  }

  .board {
    width: 100%;
    aspect-ratio: 1;
  }

  .status {
    margin: 0.75rem 0 0;
    min-height: 1.5em;
    text-align: center;
    font-weight: 600;
  }

  .setup p {
    margin: 0 0 0.5rem;
    text-align: center;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .buttons[hidden] {
    display: none;
  }

  .buttons button,
  .promotion-choices button {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .buttons button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Three columns, number then White then Black, like a scoresheet. The list
     scrolls on its own so a long game does not push the page down. Its rows
     are created by the script, which Astro's scoping cannot see, hence
     :global for everything inside the list. */
  .move-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-height: 12rem;
    overflow-y: auto;
    font-variant-numeric: tabular-nums;
  }

  .move-list :global(li) {
    display: grid;
    grid-template-columns: 3rem 1fr 1fr;
    padding: 0.15rem 0.5rem;
  }

  .move-list :global(li:nth-child(odd)) {
    background: rgb(127 127 127 / 0.12);
  }

  .move-list :global(.move-number) {
    opacity: 0.6;
  }

  .promotion {
    border: none;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    background: var(--page-background);
    color: var(--page-text);
  }

  .promotion::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .promotion p {
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .promotion-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(6rem, 1fr));
    gap: 0.5rem;
  }
</style>
