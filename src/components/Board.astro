---
// A chessboard where the visitor plays one side and the Bot plays the other,
// with the controls around a game: choosing a side, taking back, resigning,
// starting over, and the list of moves so far. The rules live in src/game/,
// the Bot's choice in src/engine/ and what the visitor may do when in
// src/session/; this component only translates between them, chessground
// (which draws the board and handles dragging and clicking) and a few buttons.
import { readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { SERVED_MODEL_DIRECTORY, SERVED_MODEL_RATING } from '../engine/served-model';

// The model the page downloads, found where scripts/stage-model.ts put it. Its
// size is read here, at build time, because the server sends it compressed and
// the browser cannot tell from the response how large it is once unpacked.
const modelFileName = readdirSync(SERVED_MODEL_DIRECTORY).find((name) => name.endsWith('.onnx'));
if (modelFileName === undefined) {
  throw new Error(`No Base Model in ${SERVED_MODEL_DIRECTORY}: run npm run stage-model`);
}
const modelBytes = statSync(join(SERVED_MODEL_DIRECTORY, modelFileName)).size;
const modelPath = `/models/${modelFileName}`;
// How a Session Game names the Base Model: after its file, whose name carries
// a hash of its contents, so two versions of a model are never confused.
const baseModelName = modelFileName.replace(/\.onnx$/, '');
---

<div
  class="board-frame"
  data-board-frame
  data-model-path={modelPath}
  data-model-bytes={modelBytes}
  data-model-rating={SERVED_MODEL_RATING}
  data-base-model={baseModelName}
>
  <div class="play">
    <div class="board"></div>
    <p class="status" data-status aria-live="polite"></p>

    <div class="model-status" data-model-status hidden>
      <progress data-model-progress></progress>
      <p data-model-message></p>
    </div>

    <div class="buttons" data-setup>
      <span class="buttons-label">Play as</span>
      <button type="button" class="brand" data-play-as="white">White</button>
      <button type="button" class="brand" data-play-as="black">Black</button>
    </div>

    <div class="buttons" data-controls hidden>
      <button type="button" data-take-back>Take back</button>
      <button type="button" data-resign>Resign</button>
      <button type="button" data-new-game>New game</button>
    </div>

    <div class="impression" data-impression hidden>
      <p>Did the Bot feel like a real player of about {SERVED_MODEL_RATING} on Lichess?</p>
      <div class="buttons" data-impression-choices>
        <button type="button" data-felt-real="yes">Yes</button>
        <button type="button" data-felt-real="no">No</button>
      </div>
      <p class="impression-thanks" data-impression-thanks hidden></p>
    </div>
  </div>

  <aside class="moves">
    <div class="moves-header">
      <h2 id="moves-heading">Moves</h2>
      <div class="browse">
        <button type="button" data-view-back aria-label="Previous position" title="Previous position (←)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <button type="button" data-view-forward aria-label="Next position" title="Next position (→)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>
    <ol class="move-list" data-move-list aria-labelledby="moves-heading"></ol>
  </aside>

  <dialog class="promotion" data-promotion aria-label="Choose a promotion piece">
    <form method="dialog">
      <p>Promote to</p>
      <div class="promotion-choices">
        <button value="queen">Queen</button>
        <button value="rook">Rook</button>
        <button value="bishop">Bishop</button>
        <button value="knight">Knight</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { Chessground } from '@lichess-org/chessground';
  import type { Key } from '@lichess-org/chessground/types';
  import type { SquareName } from 'chessops/types';
  import type { Colour } from '../board/starting-position';
  import {
    currentFen,
    isInCheck,
    isPromotion,
    legalDestinations,
    moveList,
    sideToMove,
    type MoveListRow,
    type MoveRequest,
    type PromotionPiece,
  } from '../game/game';
  import { gameStatus } from '../game/game-status';
  import { connectBot, type Bot } from '../engine/bot-client';
  import type { BotStatus } from '../engine/bot-protocol';
  import type { BotMove } from '../engine/move-selection';
  import type { DownloadProgress } from '../engine/model-download';
  import { createSessionGame, type FinishedGame } from '../session/session-game';
  import { connectTelemetry, sessionGameReport } from '../telemetry/session-game';

  /**
   * Remembered once the model has reached the browser's cache, so that a
   * returning visitor skips the entrance animation.
   */
  const MODEL_CACHED_KEY = 'chessme.model-cached';

  /** How long the entrance animation runs, matching the CSS below. */
  const ENTRANCE_MILLISECONDS = 1400;

  // Astro bundles this script once per page, however many times the component
  // is used, so it has to set up every board on the page rather than the first
  // one it finds.
  const frames = document.querySelectorAll<HTMLElement>('[data-board-frame]');
  for (const frame of frames) {
    setUpBoard(frame);
  }

  /**
   * Starts the Bot's worker, which begins downloading the model at once so the
   * wait overlaps with the visitor arriving, and wires one board and its
   * controls to a Session Game. The board opens on the starting position and
   * waits for the visitor to pick a side; New game brings it back there.
   */
  function setUpBoard(frame: HTMLElement): void {
    const boardElement = frame.querySelector<HTMLElement>('.board')!;
    const statusElement = frame.querySelector<HTMLElement>('[data-status]')!;
    const modelStatus = frame.querySelector<HTMLElement>('[data-model-status]')!;
    const setupElement = frame.querySelector<HTMLElement>('[data-setup]')!;
    const controlsElement = frame.querySelector<HTMLElement>('[data-controls]')!;
    const takeBackButton = frame.querySelector<HTMLButtonElement>('[data-take-back]')!;
    const resignButton = frame.querySelector<HTMLButtonElement>('[data-resign]')!;
    const newGameButton = frame.querySelector<HTMLButtonElement>('[data-new-game]')!;
    const moveListElement = frame.querySelector<HTMLOListElement>('[data-move-list]')!;
    const viewBackButton = frame.querySelector<HTMLButtonElement>('[data-view-back]')!;
    const viewForwardButton = frame.querySelector<HTMLButtonElement>('[data-view-forward]')!;
    const promotionDialog = frame.querySelector<HTMLDialogElement>('[data-promotion]')!;
    const impression = frame.querySelector<HTMLElement>('[data-impression]')!;
    const impressionChoices = impression.querySelector<HTMLElement>('[data-impression-choices]')!;
    const impressionButtons = impressionChoices.querySelectorAll<HTMLButtonElement>('button');
    const impressionThanks = impression.querySelector<HTMLElement>('[data-impression-thanks]')!;

    const telemetry = connectTelemetry((input, init) => window.fetch(input, init));
    const servedModel = { baseModel: frame.dataset.baseModel!, rating: Number(frame.dataset.modelRating) };
    // The id the service stored the game on the board under, once it has
    // ended and been stored: the game the end-of-game question is about.
    let storedGameId: string | undefined = undefined;

    let botStatus: BotStatus = { kind: 'downloading', progress: { receivedBytes: 0, totalBytes: undefined } };

    if (isFirstVisit()) {
      playEntrance(frame);
    }

    const bot = startBot(frame, showBotStatus);

    const session = createSessionGame({
      chooseMove: askBot,
      onChange: () => {
        showGame();
      },
      onGameEnd: reportFinishedGame,
    });

    const board = Chessground(boardElement, {
      orientation: 'white',
      coordinates: true,
      premovable: { enabled: false },
      movable: {
        free: false,
        showDests: true,
        events: {
          after: (from, to) => {
            void onVisitorMove(from, to);
          },
        },
      },
    });
    showGame();

    for (const button of frame.querySelectorAll<HTMLButtonElement>('[data-play-as]')) {
      button.addEventListener('click', () => {
        const colour = button.dataset.playAs as Colour;
        board.set({ orientation: colour });
        forgetEndedGame();
        session.start(colour).catch(() => {
          // The Bot failed while choosing its first move; its status already
          // says so, and the board only needs redrawing.
          showGame();
        });
      });
    }

    takeBackButton.addEventListener('click', () => {
      // A takeback after the end resumes the game; the stored game stays
      // stored, but the question about it is no longer asked.
      forgetEndedGame();
      session.takeBack();
    });

    resignButton.addEventListener('click', () => {
      session.resign();
    });

    newGameButton.addEventListener('click', () => {
      forgetEndedGame();
      session.startOver();
    });

    for (const button of impressionButtons) {
      button.addEventListener('click', () => {
        void sendImpression(button.dataset.feltReal === 'yes');
      });
    }

    viewBackButton.addEventListener('click', () => {
      session.viewBack();
    });

    viewForwardButton.addEventListener('click', () => {
      session.viewForward();
    });

    // The arrow keys step through positions too, as on Lichess and Chess.com.
    // Left alone while the promotion dialog is open, where they belong to it.
    document.addEventListener('keydown', (event) => {
      if (promotionDialog.open) {
        return;
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        session.viewBack();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        session.viewForward();
      }
    });

    /**
     * Reports the finished game and, once it is stored, asks the visitor what
     * they made of the Bot. A game left unfinished is never reported. The
     * question is only asked if the game is still the one on the board: the
     * visitor may have started another while the report was on its way.
     */
    function reportFinishedGame(finished: FinishedGame): void {
      const endedGame = session.game();
      const report = sessionGameReport(servedModel, finished);
      void telemetry.reportGame(report).then((gameId) => {
        const isStillOnTheBoard = session.game() === endedGame;
        if (gameId !== undefined && isStillOnTheBoard) {
          storedGameId = gameId;
          askImpression();
        }
      });
    }

    /**
     * Shows the end-of-game question. It only appears for a game the service
     * stored, since an answer needs a game to be attached to.
     */
    function askImpression(): void {
      for (const button of impressionButtons) {
        button.disabled = false;
      }
      impressionChoices.hidden = false;
      impressionThanks.hidden = true;
      impression.hidden = false;
    }

    async function sendImpression(feltLikeARealPlayer: boolean): Promise<void> {
      const gameId = storedGameId;
      if (gameId === undefined) {
        return;
      }
      for (const button of impressionButtons) {
        button.disabled = true;
      }
      const recorded = await telemetry.reportImpression(gameId, feltLikeARealPlayer);

      impressionChoices.hidden = true;
      impressionThanks.hidden = false;
      if (recorded) {
        impressionThanks.textContent = 'Thank you, your answer has been recorded.';
      } else {
        impressionThanks.textContent = 'Your answer could not be recorded.';
      }
    }

    /** Hides the question about a game that is over, as the visitor moves on from it. */
    function forgetEndedGame(): void {
      storedGameId = undefined;
      impression.hidden = true;
    }

    /**
     * The Bot's move for a position. Before the model has arrived the Opening
     * Book answers the positions it holds at once, and any other request waits
     * in the worker, so a visitor can play during the download.
     */
    async function askBot(fen: string): Promise<BotMove> {
      try {
        const reply = await bot.requestMove(fen);
        return reply;
      } catch (error) {
        // A model that failed to load has already been reported as the Bot's
        // status. A move that failed after loading has not, and without this
        // the page would say the Bot is thinking forever.
        if (botStatus.kind !== 'failed') {
          showBotStatus({ kind: 'failed', reason: (error as Error).message });
        }
        throw error;
      }
    }

    function showBotStatus(status: BotStatus): void {
      botStatus = status;
      // Exposed on the page so the Bot's state can be checked from outside,
      // as the browser check of the download and the cache does.
      frame.dataset.botStatus = status.kind;
      if (status.kind === 'ready') {
        rememberModelCached();
      }
      showModelStatus(modelStatus, status);
      showGame();
    }

    async function onVisitorMove(from: Key, to: Key): Promise<void> {
      // Chessground only lets a piece go to a square from legalDestinations,
      // which never contains its 'a0' placeholder, so both keys are real squares.
      const move: MoveRequest = {
        from: from as SquareName,
        to: to as SquareName,
      };

      if (isPromotion(session.game(), move.from, move.to)) {
        const piece = await askPromotionPiece(promotionDialog);
        if (piece === null) {
          // The visitor closed the dialog: take the pawn back to its square.
          showGame();
          return;
        }
        move.promotion = piece;
      }

      let accepted = false;
      try {
        accepted = await session.playVisitorMove(move);
      } catch {
        // The Bot failed while choosing its reply; its status already says so.
        showGame();
        return;
      }
      if (!accepted) {
        // Refused: redraw the current game, which puts the piece back.
        showGame();
      }
    }

    /**
     * Draws the position on display, states whose turn it is or how the game
     * ended, and enables only the controls the session allows right now.
     * Redrawing after every move matters even for a legal one: chessground
     * moved only the piece that was dragged, so a pawn taken en passant or a
     * promoted pawn would otherwise still show its old state.
     */
    function showGame(): void {
      const game = session.game();
      const shown = session.viewedGame();
      const visitor = session.visitor();
      const isOngoing = gameStatus(game).kind === 'ongoing';
      const isVisitorsTurn = sideToMove(game) === visitor;
      const isShowingCurrent = shown === game;
      const botFailed = botStatus.kind === 'failed';
      const isModelLoading = botStatus.kind === 'downloading' || botStatus.kind === 'preparing';

      let lastMove: Key[] | undefined = undefined;
      if (shown.lastMove !== undefined) {
        lastMove = [shown.lastMove.from, shown.lastMove.to];
      }

      // Only the visitor's pieces can be moved, only on the visitor's turn,
      // only on the current position, not while looking back, and not at all
      // once the Bot has failed, since the game cannot go on.
      let movableColour: Colour | undefined = undefined;
      if (visitor !== null && isOngoing && isVisitorsTurn && isShowingCurrent && !botFailed) {
        movableColour = visitor;
      }

      board.set({
        fen: currentFen(shown),
        turnColor: sideToMove(shown),
        lastMove: lastMove,
        check: isInCheck(shown),
        movable: {
          color: movableColour,
          dests: legalDestinations(shown),
        },
      });

      let statusText = session.status();
      if (isOngoing && botFailed) {
        statusText = 'The game cannot continue without the Bot.';
      } else if (visitor !== null && isOngoing && !isVisitorsTurn && isModelLoading) {
        statusText = 'The Bot will reply once its model has loaded.';
      }
      statusElement.textContent = statusText;

      const hasStarted = visitor !== null;
      setupElement.hidden = hasStarted;
      controlsElement.hidden = !hasStarted;
      takeBackButton.disabled = !session.canTakeBack();
      resignButton.disabled = !session.canResign();
      viewBackButton.disabled = !session.canViewBack();
      viewForwardButton.disabled = !session.canViewForward();

      showMoveList(moveListElement, moveList(game), moveList(shown));
    }
  }

  /** Starts the Bot in its own Web Worker, so its thinking never blocks the board. */
  function startBot(frame: HTMLElement, onStatus: (status: BotStatus) => void): Bot {
    const worker = new Worker(new URL('../engine/bot-worker-entry.ts', import.meta.url), { type: 'module' });

    // A worker that cannot even start, for instance on a browser without
    // WebAssembly, reports nothing through the Bot's own messages.
    worker.addEventListener('error', () => {
      onStatus({ kind: 'failed', reason: 'the browser could not start it' });
    });

    // The worker resolves URLs against its own script, so it is given a full
    // one rather than a path.
    const modelUrl = new URL(frame.dataset.modelPath!, window.location.href);
    return connectBot(
      worker,
      {
        url: modelUrl.href,
        fileBytes: Number(frame.dataset.modelBytes),
        rating: Number(frame.dataset.modelRating),
      },
      { onStatus: onStatus },
    );
  }

  /** Shows the model's download, hides it once the Bot is ready, and explains a failure. */
  function showModelStatus(container: HTMLElement, status: BotStatus): void {
    const progressBar = container.querySelector<HTMLProgressElement>('[data-model-progress]')!;
    const message = container.querySelector<HTMLElement>('[data-model-message]')!;

    if (status.kind === 'ready') {
      container.hidden = true;
      return;
    }

    container.hidden = false;
    if (status.kind === 'failed') {
      progressBar.hidden = true;
      container.classList.add('failed');
      message.textContent = `The Bot could not be loaded: ${status.reason}. Reload the page to try again.`;
      return;
    }

    if (status.kind === 'preparing') {
      progressBar.removeAttribute('value');
      message.textContent = 'Preparing the Bot…';
      return;
    }

    const progress = status.progress;
    if (progress.totalBytes === undefined) {
      // Without a total the bar can only show that something is happening.
      progressBar.removeAttribute('value');
      message.textContent = `Downloading the Bot's model: ${megabytes(progress.receivedBytes)} MB`;
    } else {
      progressBar.max = progress.totalBytes;
      progressBar.value = progress.receivedBytes;
      message.textContent = `Downloading the Bot's model: ${describeShare(progress)}`;
    }
  }

  function describeShare(progress: DownloadProgress): string {
    return `${megabytes(progress.receivedBytes)} of ${megabytes(progress.totalBytes!)} MB`;
  }

  function megabytes(bytes: number): string {
    return (bytes / 1_000_000).toFixed(1);
  }

  /**
   * True until the model has once reached the browser's cache. Storage can be
   * refused, in which case every visit counts as a first one: the animation
   * plays again, which costs the visitor nothing.
   */
  function isFirstVisit(): boolean {
    try {
      return window.localStorage.getItem(MODEL_CACHED_KEY) === null;
    } catch {
      return true;
    }
  }

  function rememberModelCached(): void {
    // Where the browser offers no Cache API the model was not kept, and the
    // next visit downloads it again: that visit is a first one too.
    if (!('caches' in window)) {
      return;
    }
    try {
      window.localStorage.setItem(MODEL_CACHED_KEY, 'yes');
    } catch {
      // Nothing to do: the next visit plays the entrance again.
    }
  }

  /**
   * Plays the entrance: the board appears, then the pieces settle onto their
   * squares. The class is removed afterwards, because chessground creates new
   * piece elements during play and they must not replay it. The board accepts
   * moves throughout, so the animation never delays play.
   */
  function playEntrance(frame: HTMLElement): void {
    frame.classList.add('entering');
    window.setTimeout(() => {
      frame.classList.remove('entering');
    }, ENTRANCE_MILLISECONDS);
  }

  /**
   * Writes the moves so far as numbered rows and marks the move that led to
   * the position on display, so the eye finds it, keeping it in view. The
   * shown rows are the list up to that position: its last move is the one to
   * mark, and none is marked at the starting position.
   */
  function showMoveList(listElement: HTMLOListElement, rows: MoveListRow[], shownRows: MoveListRow[]): void {
    const markedRowIndex = shownRows.length - 1;
    let isBlackMoveMarked = false;
    if (markedRowIndex >= 0) {
      isBlackMoveMarked = shownRows[markedRowIndex].black !== null;
    }

    const items: HTMLLIElement[] = [];
    let markedMove: HTMLSpanElement | null = null;

    for (const [rowIndex, row] of rows.entries()) {
      const whiteMove = moveListCell('move', row.white ?? '…');
      const blackMove = moveListCell('move', row.black ?? '');

      const item = document.createElement('li');
      item.append(moveListCell('move-number', `${row.moveNumber}.`), whiteMove, blackMove);
      items.push(item);

      if (rowIndex === markedRowIndex) {
        if (isBlackMoveMarked) {
          markedMove = blackMove;
        } else {
          markedMove = whiteMove;
        }
      }
    }

    listElement.replaceChildren(...items);
    if (markedMove !== null) {
      markedMove.classList.add('latest');
      scrollListTo(listElement, markedMove);
    }
  }

  /**
   * Scrolls the list, and only the list, just enough to show the element.
   * scrollIntoView would also scroll the page, which on a phone would jump
   * from the board down to the list after every move.
   */
  function scrollListTo(listElement: HTMLElement, element: HTMLElement): void {
    const listBox = listElement.getBoundingClientRect();
    const elementBox = element.getBoundingClientRect();

    if (elementBox.top < listBox.top) {
      listElement.scrollTop -= listBox.top - elementBox.top;
    } else if (elementBox.bottom > listBox.bottom) {
      listElement.scrollTop += elementBox.bottom - listBox.bottom;
    }
  }

  function moveListCell(className: string, text: string): HTMLSpanElement {
    const cell = document.createElement('span');
    cell.className = className;
    cell.textContent = text;
    return cell;
  }

  /** Opens the promotion dialog and resolves with the chosen piece, or null if it was dismissed. */
  function askPromotionPiece(dialog: HTMLDialogElement): Promise<PromotionPiece | null> {
    return new Promise((resolve) => {
      dialog.returnValue = '';
      dialog.addEventListener(
        'close',
        () => {
          const choice = dialog.returnValue;
          if (choice === 'queen' || choice === 'rook' || choice === 'bishop' || choice === 'knight') {
            resolve(choice);
          } else {
            resolve(null);
          }
        },
        { once: true },
      );
      dialog.showModal();
    });
  }
</script>

<style is:global>
  @import '@lichess-org/chessground/assets/chessground.base.css';
  @import '@lichess-org/chessground/assets/chessground.brown.css';
  @import '@lichess-org/chessground/assets/chessground.cburnett.css';

  /* Chessground's stock coordinates hang outside the board: the file letters
     sit at left: 24px with width: 100%, so they run 24px past the right edge,
     and the rank digits sit at top: -20px. On a phone that overhang becomes
     horizontal page scroll, and the file letters land under the wrong files.
     Pull both back inside the board. */
  .board-frame .cg-wrap coords.files {
    left: 0;
  }

  .board-frame .cg-wrap coords.ranks {
    top: 0;
  }

  /* The first-visit entrance: the board fades in, then the white pieces and
     the black ones drop onto their squares. Pieces are placed by chessground
     through their transform, so the drop uses the separate translate property,
     which adds to it. The board only fades: scaling it would skew the bounds
     chessground measures once for dragging. Under 1.4 s in all, the time the
     page script keeps the class on. */
  @media (prefers-reduced-motion: no-preference) {
    .board-frame.entering .cg-wrap {
      animation: board-appear 450ms ease-out both;
    }

    .board-frame.entering piece {
      animation: piece-settle 550ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: 350ms;
    }

    .board-frame.entering piece.black {
      animation-delay: 550ms;
    }
  }

  @keyframes board-appear {
    from {
      opacity: 0;
    }
  }

  @keyframes piece-settle {
    from {
      opacity: 0;
      translate: 0 -35%;
    }
  }
</style>

<style>
  /* On a phone everything stacks: board, controls, then the moves. From
     960px the moves move into their own column on the right, behind a divider
     line, and the whole thing fits the screen height without scrolling. */
  .board-frame {
    display: grid;
    gap: 1.5rem;
  }

  .play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* Chessground sizes itself to its container, so the container is where the
     responsive behaviour belongs. */
  .board {
    width: 100%;
    max-width: 40rem;
    aspect-ratio: 1;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    text-align: center;
    font-weight: 600;
    color: var(--text-1);
  }

  .model-status {
    width: 100%;
    max-width: 24rem;
    text-align: center;
  }

  .model-status[hidden] {
    display: none;
  }

  .model-status progress {
    width: 100%;
  }

  .model-status p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .model-status.failed p {
    font-weight: 600;
    color: var(--text-1);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
