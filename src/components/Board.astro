---
// A chessboard where the visitor plays one side and the Bot plays the other.
// The rules live in src/game/ and the Bot's choice in src/engine/; this
// component only translates between them and chessground, which draws the
// board and handles dragging and clicking.
import type { Colour } from '../board/starting-position';

interface Props {
  /** The visitor's side, which also sits at the bottom of the board. */
  orientation?: Colour;
}

const { orientation = 'white' } = Astro.props;
---

<div class="board-frame" data-board-frame>
  <div class="board" data-orientation={orientation}></div>
  <p class="status" data-status aria-live="polite"></p>

  <dialog class="promotion" data-promotion aria-label="Choose a promotion piece">
    <form method="dialog">
      <p>Promote to</p>
      <div class="promotion-choices">
        <button value="queen">Queen</button>
        <button value="rook">Rook</button>
        <button value="bishop">Bishop</button>
        <button value="knight">Knight</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { Chessground } from '@lichess-org/chessground';
  import type { Api } from '@lichess-org/chessground/api';
  import type { Key } from '@lichess-org/chessground/types';
  import type { SquareName } from 'chessops/types';
  import type { Colour } from '../board/starting-position';
  import {
    currentFen,
    isInCheck,
    isPromotion,
    legalDestinations,
    newGame,
    playMove,
    sideToMove,
    type Game,
    type MoveRequest,
    type PromotionPiece,
  } from '../game/game';
  import { describeResult, gameStatus } from '../game/game-status';
  import { selectMove } from '../engine/move-selection';

  // Astro bundles this script once per page, however many times the component
  // is used, so it has to set up every board on the page rather than the first
  // one it finds.
  const frames = document.querySelectorAll<HTMLElement>('[data-board-frame]');
  for (const frame of frames) {
    setUpBoard(frame);
  }

  /** Starts a new game on one board, with the visitor on the side facing them. */
  function setUpBoard(frame: HTMLElement): void {
    const boardElement = frame.querySelector<HTMLElement>('.board')!;
    const statusElement = frame.querySelector<HTMLElement>('[data-status]')!;
    const promotionDialog = frame.querySelector<HTMLDialogElement>('[data-promotion]')!;
    const playerColour = (boardElement.dataset.orientation ?? 'white') as Colour;

    let game = newGame();

    const board = Chessground(boardElement, {
      orientation: playerColour,
      coordinates: true,
      premovable: { enabled: false },
      movable: {
        free: false,
        showDests: true,
        events: {
          after: (from, to) => {
            void onPlayerMove(from, to);
          },
        },
      },
    });
    showGame(board, statusElement, game, playerColour);

    if (sideToMove(game) !== playerColour) {
      void playBotMove();
    }

    async function onPlayerMove(from: Key, to: Key): Promise<void> {
      // Chessground only lets a piece go to a square from legalDestinations,
      // which never contains its 'a0' placeholder, so both keys are real squares.
      const move: MoveRequest = {
        from: from as SquareName,
        to: to as SquareName,
      };

      if (isPromotion(game, move.from, move.to)) {
        const piece = await askPromotionPiece(promotionDialog);
        if (piece === null) {
          // The player closed the dialog: take the pawn back to its square.
          showGame(board, statusElement, game, playerColour);
          return;
        }
        move.promotion = piece;
      }

      const next = playMove(game, move);
      if (next === null) {
        // Refused: redraw the current game, which puts the piece back.
        showGame(board, statusElement, game, playerColour);
        return;
      }

      game = next;
      // Redraw from the game even after a legal move: chessground moved only
      // the piece that was dragged, so a pawn taken en passant or a promoted
      // pawn would otherwise still show its old state.
      showGame(board, statusElement, game, playerColour);

      if (gameStatus(game).kind === 'ongoing') {
        await playBotMove();
      }
    }

    /** Asks the engine for the Bot's reply and plays it. */
    async function playBotMove(): Promise<void> {
      const reply = await selectMove(currentFen(game));

      const next = playMove(game, reply);
      if (next === null) {
        throw new Error(`The engine chose an illegal move: ${reply.from}-${reply.to} in ${currentFen(game)}`);
      }

      game = next;
      showGame(board, statusElement, game, playerColour);
    }
  }

  /**
   * Draws the game on the board and states whose turn it is or how it ended.
   * Only the visitor's pieces can be moved, and only on the visitor's turn.
   */
  function showGame(board: Api, statusElement: HTMLElement, game: Game, playerColour: Colour): void {
    const status = gameStatus(game);
    const result = describeResult(status);
    const isOver = result !== null;
    const isPlayersTurn = sideToMove(game) === playerColour;

    let lastMove: Key[] | undefined = undefined;
    if (game.lastMove !== undefined) {
      lastMove = [game.lastMove.from, game.lastMove.to];
    }

    let movableColour: Colour | undefined = undefined;
    if (!isOver && isPlayersTurn) {
      movableColour = playerColour;
    }

    board.set({
      fen: currentFen(game),
      turnColor: sideToMove(game),
      lastMove: lastMove,
      check: isInCheck(game),
      movable: {
        color: movableColour,
        dests: legalDestinations(game),
      },
    });

    if (isOver) {
      statusElement.textContent = result;
    } else if (isPlayersTurn) {
      statusElement.textContent = 'Your move.';
    } else {
      statusElement.textContent = 'The Bot is thinking…';
    }
  }

  /** Opens the promotion dialog and resolves with the chosen piece, or null if it was dismissed. */
  function askPromotionPiece(dialog: HTMLDialogElement): Promise<PromotionPiece | null> {
    return new Promise((resolve) => {
      dialog.returnValue = '';
      dialog.addEventListener(
        'close',
        () => {
          const choice = dialog.returnValue;
          if (choice === 'queen' || choice === 'rook' || choice === 'bishop' || choice === 'knight') {
            resolve(choice);
          } else {
            resolve(null);
          }
        },
        { once: true },
      );
      dialog.showModal();
    });
  }
</script>

<style is:global>
  @import '@lichess-org/chessground/assets/chessground.base.css';
  @import '@lichess-org/chessground/assets/chessground.brown.css';
  @import '@lichess-org/chessground/assets/chessground.cburnett.css';

  /* Chessground's stock coordinates hang outside the board: the file letters
     sit at left: 24px with width: 100%, so they run 24px past the right edge,
     and the rank digits sit at top: -20px. On a phone that overhang becomes
     horizontal page scroll, and the file letters land under the wrong files.
     Pull both back inside the board. */
  .board-frame .cg-wrap coords.files {
    left: 0;
  }

  .board-frame .cg-wrap coords.ranks {
    top: 0;
  }
</style>

<style>
  /* The frame caps the board on wide screens and lets it shrink on a phone.
     Chessground sizes itself to its container, so the container is where the
     responsive behaviour belongs. */
  .board-frame {
    width: 100%;
    max-width: min(90vh, 40rem);
    margin-inline: auto;
  }

  .board {
    width: 100%;
    aspect-ratio: 1;
  }

  .status {
    margin: 0.75rem 0 0;
    min-height: 1.5em;
    text-align: center;
    font-weight: 600;
  }

  .promotion {
    border: none;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    background: var(--page-background);
    color: var(--page-text);
  }

  .promotion::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .promotion p {
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .promotion-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(6rem, 1fr));
    gap: 0.5rem;
  }

  .promotion-choices button {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
</style>
