---
// The page a visitor lands on to play the Bot. The page is written in English
// and switches to French with the buttons in its header.
import GameLayout from '../components/templates/GameLayout.astro';
import Game from '../components/organisms/Game.astro';
import MicroText from '../components/atoms/MicroText.astro';
import LanguageSwitch from '../components/molecules/LanguageSwitch.astro';
---

<GameLayout title="ChessMe" description="Play a game of chess against a bot that imitates Camille.">
  <Game>
    <header class="intro" slot="header">
      <h1>ChessMe</h1>
      <MicroText as="p" textKey="intro">Play a game against a bot that imitates Camille.</MicroText>
      <LanguageSwitch />
    </header>
  </Game>
</GameLayout>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-title);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }
</style>
