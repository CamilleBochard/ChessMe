---
// The page a visitor lands on to play the Bot.
import Board from '../components/Board.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ChessMe</title>
    <meta
      name="description"
      content="Play a game of chess against a bot that imitates Camille."
    />
  </head>
  <body>
    <main>
      <header class="intro">
        <h1>ChessMe</h1>
        <p>Play a game against a bot that imitates Camille.</p>
      </header>
      <Board />
    </main>
  </body>
</html>

<style is:global>
  /* A documentation-site look: white or near-black surfaces, grey text in
     three strengths, hairline dividers between columns, and one green accent. */
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --bg-soft: #f6f6f7;
    --text-1: #3c3c43;
    --text-2: #67676c;
    --text-3: #929295;
    --divider: #e2e2e3;
    --default-soft: rgb(142 150 170 / 0.14);
    --brand: #008039;
    --brand-contrast: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171d;
      --bg-soft: #202127;
      --text-1: #ffffff;
      --text-2: #98989f;
      --text-3: #6a6a71;
      --divider: #2e2e32;
      --default-soft: rgb(101 117 133 / 0.16);
      --brand: #22ff73;
      --brand-contrast: #16171d;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-1);
    font-family: Inter, system-ui, sans-serif;
    line-height: 1.5;
  }
</style>

<style>
  /* On a phone the intro sits above the board. From 960px the page becomes
     three columns that fill the screen exactly: the intro, set against the
     board's left edge, then the board, then the moves on the far right. The
     intro's column takes whatever width the board and the moves leave. */
  main {
    padding: 1.5rem 1rem;
  }

  .intro {
    margin-bottom: 1.5rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .intro p {
    margin: 0;
    color: var(--text-2);
  }

  @media (min-width: 960px) {
    main {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) auto 17rem;
      height: 100dvh;
      padding: 0;
    }

    /* Top padding matches the board's, so the title lines up with the board's
       top edge. */
    .intro {
      margin: 0;
      padding: 2rem 1.5rem;
      text-align: right;
    }

    .intro p {
      max-width: 16rem;
      margin-left: auto;
    }
  }
</style>
