---
// The page a visitor lands on to play the Bot. Once a game has ended, the
// summary of every game played on the site appears beside the board.
import GameLayout from '../components/templates/GameLayout.astro';
import Game from '../components/organisms/Game.astro';
import MicroText from '../components/atoms/MicroText.astro';
import SessionGameSummary from '../components/organisms/SessionGameSummary.astro';
---

<GameLayout title="ChessMe" description="Play a game of chess against a bot that imitates Camille.">
  <Game>
    <header class="intro" slot="header">
      <h1>ChessMe</h1>
      <MicroText as="p">Play a game against a bot that imitates Camille.</MicroText>
    </header>
    <SessionGameSummary slot="after-game" readOn="game-end" title="Games on this site" />
  </Game>
</GameLayout>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-title);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }
</style>
